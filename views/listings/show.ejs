<%= layout("/layouts/boilerplate") %>

<h2><%= allListings.title %></h2>

<div class="row">
    <div class="col-8 offset-1">

        <div class="card listing-card" style="width: 18rem;">
            <img src="<%= allListings.image.url %>" class="card-img-top mt-3">

            <div class="card-body">
                <p>
                    Owned by <%= allListings.owner?.username || "Unknown" %> <br>
                    <%= allListings.description %> <br>
                    ₹<%= allListings.price.toLocaleString("en-IN") %> <br>
                    <%= allListings.location %> <br>
                    <%= allListings.country %>
                </p>
            </div>
        </div>

    </div>
</div>

<% if(currentuser && allListings.owner && currentuser._id.equals(allListings.owner._id)) { %>
<div class="btn-container">
    <a class="btn edit-btn" href="/listing/<%= allListings._id %>/edit">Edit</a>

    <form action="/listing/<%= allListings._id %>?_method=DELETE" method="post">
        <button class="btn btn-dark">Delete</button>
    </form>
</div>
<% } %>

<hr>

<div class="col-8 offset-2">

    <% if(currentuser){ %>
    <h4>Leave a review</h4>

    <form action="/listing/<%= allListings._id %>/reviews" method="post">

        <textarea name="review[comment]" required class="form-control"></textarea>

        <button class="btn btn-outline-dark mt-2">Submit</button>
    </form>
    <% } %>

    <hr>

    <h5>All Reviews</h5>

    <% for(review of allListings.reviews){ %>
        <div class="card mb-2">
            <div class="card-body">
                <b><%= review.author?.username || "User" %></b>
                <p><%= review.comment %></p>

                <form action="/listing/<%= allListings._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                    <button class="btn btn-sm btn-dark">Delete</button>
                </form>
            </div>
        </div>
    <% } %>

</div>